# Copy to .env and replace every value before running docker compose.
# Never commit the real .env file.

# SQL Server SA password (must satisfy SQL Server complexity rules: 8+ chars, upper, lower, digit, symbol)
MSSQL_SA_PASSWORD=Change_Me_Str0ng!Passw0rd

# HS256 signing key for API JWTs - at least 32 characters
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-chars

# Shared secret between the .NET API and the Python classifier sidecar (X-Api-Key header)
CLASSIFIER_API_KEY=replace-with-a-random-sidecar-key

# Classifier LLM provider: offline (default, deterministic heuristics) | openai | anthropic
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
