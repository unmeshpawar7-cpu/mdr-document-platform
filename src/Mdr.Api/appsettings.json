{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MdrDatabase": "Server=localhost,1433;Database=MdrDocumentPlatform;User Id=sa;Password=SET_VIA_ConnectionStrings__MdrDatabase;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnsureCreated": false
  },
  "Jwt": {
    "Issuer": "mdr-document-platform",
    "Audience": "mdr-document-platform-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Storage": {
    "RootPath": "data/uploads"
  },
  "MdrProcessing": {
    "MaxFileSizeBytes": 10485760,
    "MaxRows": 50000,
    "Policy": "PersistValidRows",
    "PersistenceBatchSize": 500,
    "QueueCapacity": 100,
    "MaxParallelUploads": 2,
    "MaxProcessingAttempts": 3,
    "AiBatchSize": 50,
    "AiLowConfidenceThreshold": 0.6,
    "AiMaxExistingHints": 500
  },
  "Classifier": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "",
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 30,
    "MaxRetryAttempts": 2
  },
  "RateLimiting": {
    "UploadsPerMinute": 10,
    "AuthAttemptsPerMinute": 20
  },
  "Swagger": {
    "Enabled": false
  }
}
